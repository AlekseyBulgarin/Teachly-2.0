NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://teachly:teachly@localhost:5432/teachly
# Optional direct connection used by migration and production demo-seed commands.
DATABASE_URL_UNPOOLED=
DEV_AUTH_ENABLED=true
DEV_TEACHER_EXTERNAL_SUBJECT=dev-teacher
DEV_STUDENT_EXTERNAL_SUBJECT=dev-student
AI_PROVIDER=disabled
AI_PROVIDER_NAME=
AI_API_KEY=
# Backward-compatible alias for direct OpenAI usage.
OPENAI_API_KEY=
AI_BASE_URL=
AI_API_MODE=responses
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=10000
METRICS_TOKEN=
SERVICE_VERSION=development
DEPLOYMENT_ENVIRONMENT=development

# Production demo seeding only. Keep disabled outside the explicit one-time seed command.
TEACHLY_DEMO_SEED_ENABLED=false
TEACHLY_DEMO_API_KEY=

# Use a dedicated direct (non-pooler) database URL for destructive test resets.
TEST_DATABASE_URL=postgres://teachly:teachly@localhost:5432/teachly_test
ALLOW_TEST_DB_RESET=false
