TEACHLY_API_URL=https://teachlyapi-production.up.railway.app
TEACHLY_API_KEY=replace-with-a-workspace-api-key
TEACHLY_EXTERNAL_USER_ID=your-learner-id
# Stable value: rerunning the same pilot safely replays idempotent writes.
TEACHLY_PILOT_RUN_ID=partner-sandbox-learner-001-v1
# Optional. When set, the consumer submits this existing option and requests AI remediation when configured.
# TEACHLY_SAMPLE_ANSWER_OPTION_ID=option-a
# TEACHLY_LEARNER_QUESTION=Why was this choice incorrect?
