# Local development only. Production must set every value explicitly.
TEACHLY_API_URL=http://127.0.0.1:3001
TEACHLY_DEMO_API_KEY=tlk_00000000000000dd.teachly-demo-key
# Recommended in deployed environments. Rotating it invalidates existing demo whiteboard cookies.
# If omitted, the server-only demo API key is used as the signing secret.
TEACHLY_DEMO_SESSION_SECRET=
TEACHLY_DEMO_EXTERNAL_LEARNER_ID=demo-learner-01
TEACHLY_DEMO_TASK_IDS=00000000-0000-4000-8000-000000000007,00000000-0000-4000-8000-000000000026
